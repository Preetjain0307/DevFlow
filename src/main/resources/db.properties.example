# Database Connection Configuration Template
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/devflow_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.username=root
db.password=root

db.pool.maximumPoolSize=10
db.pool.minimumIdle=2
db.pool.idleTimeout=30000
db.pool.connectionTimeout=20000
db.pool.maxLifetime=1800000

app.upload.dir=uploads
app.jitsi.domain=meet.jit.si
github.token=
ai.api.key=
ai.api.provider=DEFAULT
